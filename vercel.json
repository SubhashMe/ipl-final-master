{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)\\.(js|css|html|png|jpg|jpeg|svg|csv)",
      "dest": "/public/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
